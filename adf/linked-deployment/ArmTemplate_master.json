{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "factoryName": {
      "type": "string",
      "metadata": "Data Factory name",
      "defaultValue": "tokyoadf21"
    },
    "AzureDataLakeStorage1_accountKey": {
      "type": "secureString",
      "metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
    },
    "AzureDataLakeStorage1_properties_typeProperties_url": {
      "type": "string",
      "defaultValue": "https://tokyoolympic21.dfs.core.windows.net/"
    },
    "Httpmedals_properties_typeProperties_url": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com"
    },
    "HttpGender_properties_typeProperties_url": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com"
    },
    "HttpMedal_properties_typeProperties_url": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com"
    },
    "Httpathletes_properties_typeProperties_url": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com"
    },
    "HttpCoaches_properties_typeProperties_url": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com"
    },
    "containerUri": {
      "type": "string",
      "metadata": "URI to storage account containing linked ARM templates"
    },
    "containerSasToken": {
      "type": "string",
      "metadata": "Sas token to storage account containing linked ARM templates"
    }
  },
  "variables": {
    "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
  },
  "resources": [
    {
      "name": "tokyoadf21_ArmTemplate_0",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2024-03-01",
      "properties": {
        "mode": "incremental",
        "templateLink": {
          "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "factoryName": {
            "value": "[parameters('factoryName')]"
          },
          "AzureDataLakeStorage1_accountKey": {
            "value": "[parameters('AzureDataLakeStorage1_accountKey')]"
          },
          "AzureDataLakeStorage1_properties_typeProperties_url": {
            "value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
          },
          "Httpmedals_properties_typeProperties_url": {
            "value": "[parameters('Httpmedals_properties_typeProperties_url')]"
          },
          "HttpGender_properties_typeProperties_url": {
            "value": "[parameters('HttpGender_properties_typeProperties_url')]"
          },
          "HttpMedal_properties_typeProperties_url": {
            "value": "[parameters('HttpMedal_properties_typeProperties_url')]"
          },
          "Httpathletes_properties_typeProperties_url": {
            "value": "[parameters('Httpathletes_properties_typeProperties_url')]"
          },
          "HttpCoaches_properties_typeProperties_url": {
            "value": "[parameters('HttpCoaches_properties_typeProperties_url')]"
          }
        }
      },
      "dependsOn": []
    }
  ]
}
